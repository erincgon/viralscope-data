# ViralScope Engine — optional configuration (all free, no paid APIs)

# Scraping
REQUEST_TIMEOUT=25
MAX_RETRIES=3
CONCURRENT_REQUESTS=4
GOOGLE_TRENDS_GEO=US
YOUTUBE_REGION=US
USE_PYTRENDS=true

# Optional Reddit API (free tier at reddit.com/prefs/apps)
# Leave empty to use public JSON endpoints
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ViralScopeEngine/2.0 (trend research)

# Export
EXPORT_DIR=exports
FREE_TREND_LIMIT=3

# Scheduler
SCHEDULE_INTERVAL_HOURS=6
RUN_ON_STARTUP=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
